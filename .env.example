# Copy this file to .env and fill in real values.
# .env is already in .gitignore — never commit real keys.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider key (Qwen / Alibaba Cloud Model Studio)
VITE_AI_API_KEY=

# Optional — only set these if the default doesn't work for your account.
# Find your exact base_url in Model Studio console -> API-KEY / Endpoints page.
# VITE_AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# VITE_AI_MODEL=qwen-plus
